\set ON_ERROR_STOP on
\if :{?raid_commit}
\else
\set raid_commit false
\endif
begin;
set local statement_timeout='60s';
set local lock_timeout='2s';
set local search_path=public,pg_catalog;
\ir ../../raid-production-preparation/bundle/00-baseline-guard.sql
\ir ../../raid-production-preparation/bundle/01-snapshot-dependency.sql
\ir ../../raid-production-preparation/bundle/02-raid-delta.sql
\ir ../../raid-production-preparation/bundle/04-postflight.sql
\ir 06-launch-balance.sql
\ir 07-launch-postflight.sql
notify pgrst,'reload schema';
\if :raid_commit
commit;
\else
rollback;
\endif
-- Cron/reward activation remains a separate reviewed step; no applied SQL replay.
