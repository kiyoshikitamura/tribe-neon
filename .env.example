NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_USE_MOCK_DB=false
NEXT_PUBLIC_ENABLE_QA_TOOLS=false
SUPABASE_EXPECTED_PROJECT_REF=

# KPI branch-scoped Preview only. Production KPI access requires:
# NEXT_PUBLIC_APP_ENV=preview, NEXT_PUBLIC_KPI_DATA_ENV=production, and the
# standard https://ktpolnkyyfkowxdmijww.supabase.co project origin.
NEXT_PUBLIC_KPI_DATA_ENV=

# Public release metadata. Keep indexing disabled until the exact Production
# hostname, legal pages, release assets, and Production smoke test are approved.
# SITE_ORIGIN must be an HTTPS origin only (no path, query, or trailing data).
SITE_ORIGIN=
RELEASE_INDEXING_ENABLED=false

# Server-only. Required for the Preview KPI manual-refresh endpoint.
# Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HTTP Basic credentials for /admin/kpi and /api/admin/kpi/*.
KPI_BASIC_AUTH_USER=
KPI_BASIC_AUTH_PASSWORD=

# Local/CI-only test account. Never set these in Vercel production or commit real values.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
